# Généré par ./setup.sh — ne jamais versionner le fichier .env
DOMAIN=sms.exemple.ma
LETSENCRYPT_EMAIL=admin@exemple.ma

POSTGRES_DB=sms
POSTGRES_USER=sms
POSTGRES_PASSWORD=change-me

SECRET_KEY=change-me
# Fernet, séparées par des virgules : la 1re chiffre, toutes déchiffrent (rotation : manage.sh rotate-keys)
APP_ENCRYPTION_KEYS=change-me

TIMEZONE=Africa/Casablanca
DEFAULT_REGION=MA
MAX_UPLOAD_MB=10
IMPORT_RETENTION_DAYS=30
LOG_LEVEL=INFO

# Sauvegardes PostgreSQL (heure locale Casablanca)
BACKUP_TIME=02:30
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./backups
