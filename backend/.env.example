# Copier en .env puis adapter. Ne jamais versionner le fichier .env.
# development | production
APP_ENV=development

# Clé de session Flask : python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Clés de chiffrement Fernet, séparées par des virgules (la 1re chiffre, toutes déchiffrent)
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEYS=

# SQLite par défaut (instance/sms.db) ; en production :
# DATABASE_URL=postgresql://sms:motdepasse@db:5432/sms
DATABASE_URL=

# URL publique du serveur (encodée dans le QR d'appairage du téléphone)
PUBLIC_BASE_URL=http://192.168.1.10:5000

TIMEZONE=Africa/Casablanca
DEFAULT_REGION=MA

MAX_UPLOAD_MB=10
IMPORT_MAX_ROWS=50000
IMPORT_RETENTION_DAYS=30

DEVICE_OFFLINE_AFTER_SEC=90
DEVICE_ACK_TIMEOUT_SEC=120
DISPATCH_BATCH_MAX=20
PAIRING_CODE_TTL_MIN=10

WEBHOOK_TIMEOUT_SEC=10
# Autoriser les webhooks http:// et les adresses privées (dev uniquement)
WEBHOOK_ALLOW_HTTP=false

SESSION_COOKIE_SECURE=false
LOG_LEVEL=INFO
